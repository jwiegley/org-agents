# Byte- and native-compiled output.  Never committed: `make gate' rebuilds
# what it needs, and a stale .elc sitting beside a newer .el is the classic
# reason a fix appears not to have taken.
*.elc
*.eln
/eln-cache/

# `org-id' writes this the moment a test forgets to bind
# `org-id-locations-file'.  Machine-local either way.
.org-id-locations

# Emacs's own droppings: auto-save files, lock files, backups.
\#*\#
.\#*
*~

# The manual's Texinfo intermediate.  Regenerated by `make manual' in
# about a second, and a six-thousand-line generated file in a diff is
# noise.  The .info beside it IS committed: this package has no ELPA build
# and no install step, so a generated manual nobody generates is a manual
# nobody reads.
/doc/org-agents.texi

# macOS.
.DS_Store
